        "### **1. Handle Missing Values**"
      ],
      "metadata": {
        "id": "zFgwEmX0RNf7"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "numeric_cols = [\n",
        "    'normalized-losses', 'bore', 'stroke', 'horsepower', 'peak-rpm'\n",
        "]\n",
        "\n",
        "for col in numeric_cols:\n",
        "    df[col] = df[col].replace('?', np.nan)\n",
        "    df[col] = pd.to_numeric(df[col], errors='coerce')\n",
        "\n",
        "df['price'] = df['price'].replace('?', np.nan)\n",
        "df['price'] = pd.to_numeric(df['price'], errors='coerce')\n",
        "\n",
        "# Fill missing instead of dropping\n",
        "df = df.fillna(df.mean(numeric_only=True))\n",
        "\n",
        "# Fix categorical column\n",
        "df['engine-location'] = df['engine-location'].astype(str).str.strip().str.lower()\n",
        "df['engine-location'] = df['engine-location'].map({'front': 0, 'rear': 1})\n",
        "df = df.drop('engine-location', axis=1)"
