        "    # Concatenate train and validation data for the current column to fit LabelEncoder\n",
        "    # Ensure data is treated as string to handle any mixed types robustly\n",
        "    combined_data = pd.concat([X_train[col], X_val[col]], axis=0).astype(str)\n",
        "    le.fit(combined_data.unique())\n",
        "\n",
        "    # Transform both training and validation sets\n",
        "    X_train[col] = le.transform(X_train[col].astype(str))\n",
